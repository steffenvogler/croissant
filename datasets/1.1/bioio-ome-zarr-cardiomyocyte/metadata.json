  "@type": "sc:Dataset",
  "name": "bioio-ome-zarr-cardiomyocyte",
  "description": "An example of a remote OME-Zarr loaded end-to-end through Croissant. The OME-NGFF store is distributed as a .zip on Zenodo, so Croissant downloads and extracts it, then reads the image with bioio. The store is an HCS plate, so the image lives in a well/field subgroup (B/03/0); only the headers (dimensions, chunking) are read here, without loading any pixels.",
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "creator": {
    "@type": "sc:Person",
    "name": "Joel L\u00fcthi"
  },
  "keywords": [
    "bioio",
    "OME-Zarr",
    "OME-NGFF",
    "HCS",
    "microscopy",
    "biomedical"
  ],
  "license": "https://creativecommons.org/licenses/by/4.0/",
